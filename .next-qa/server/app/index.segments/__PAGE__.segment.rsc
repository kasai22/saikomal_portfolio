ccessible table and form patterns.","tags":["Role-based interfaces","Exception handling","Bulk actions","Audit trails","Accessible tables & forms"],"accentColor":"#3D5A80","slug":"/case-study/onliest-hr-admin","timeline":"2026","image":null,"imageAlt":"","role":"UX Designer","context":"Onliest","readMins":3,"format":"summary","metrics":[]}}]}],["$","$L8","kudra",{"variant":"scale","children":["$","$L9",null,{"project":{"id":"kudra","title":"Kudra — Fleet & Trip Management","name":"Kudra","subtitle":"Fleet & Trip Management","description":"Led UX across trip creation, driver and vehicle assignment, fuel tracking and fleet monitoring — field research with drivers, dispatchers and supervisors turned call-and-spreadsheet coordination into one trip-centric system.","tags":["Field research","Trip lifecycle","Fleet dashboards","Data-heavy interfaces","Operational decision-making"],"accentColor":"#956807","slug":"/case-study/kudra","timeline":"2025–2026","image":"/figmaAssets/kudra-dashboard.png","imageAlt":"Kudra fleet operations dashboard","role":"Product Owner & UX Designer","context":"ONDL","readMins":9,"format":"full","metrics":[{"value":"20%","label":"Less trip-creation effort"},{"value":"30%","label":"Less manual operational effort"}]},"slot":1}]}],["$","$L8","clappit",{"variant":"scale","children":["$","$L9",null,{"project":{"id":"clappit","title":"ClappIt — Cloud Infrastructure Platform","name":"ClappIt","subtitle":"Cloud Infrastructure Platform","description":"Simplified complex cloud-infrastructure workflows for technical and non-technical users through clearer information architecture, navigation and reusable interface patterns.","tags":["Complex technical products","Infrastructure workflows","Information architecture","Reusable UI patterns"],"accentColor":"#B3202F","slug":"/case-study/clappit","timeline":"2023–2024","image":"/figmaAssets/clappit-dashboard.png","imageAlt":"ClappIt cluster dashboard with pods health, application performance, severity-coded alerts
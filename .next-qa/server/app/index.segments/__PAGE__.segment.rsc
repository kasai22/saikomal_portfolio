n":"UX & product projects"}],["$","dd",null,{"className":"text-[24px] font-medium leading-none tracking-[-0.03em] tabular-nums text-brand-ink","children":["$","$L1a",null,{"value":"5"}]}]]}],["$","div","Independent engineering projects",{"className":"flex flex-col-reverse justify-end gap-1.5","children":[["$","dt",null,{"className":"t-meta text-ink/62","children":"Independent engineering projects"}],["$","dd",null,{"className":"text-[24px] font-medium leading-none tracking-[-0.03em] tabular-nums text-brand-ink","children":["$","$L1a",null,{"value":"4"}]}]]}]]}],["$","$L1b",null,{"as":"a","href":"/SaiKomal_Resume.pdf","download":"SaiKomal_Resume.pdf","data-cursor":"open","className":"shrink-0 self-start lg:self-center","children":["Download résumé",["$","svg",null,{"fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","aria-hidden":"true","className":"h-3.5 w-3.5","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"}]}]]}]]}]}]
c:["$","section",null,{"id":"engineering","className":"relative px-6 py-16 sm:py-20","children":["$undefined",["$","div",null,{"className":"relative mx-auto w-full max-w-6xl","children":[["$","div",null,{"className":"mb-10","children":[["$","$L1c",null,{"from":"left","children":["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"t-eyebrow tabular-nums text-brand-ink","children":"02"}],["$","span",null,{"className":"h-px w-6 bg-brand/60","aria-hidden":"true"}],["$","span",null,{"className":"t-eyebrow text-ink/60","children":"Independent engineering projects"}]]}]}],["$","$L1c",null,{"from":"left","delay":0.08,"children":["$","h2",null,{"className":"t-h2 mt-3 max-w-2xl text-ink","children":["Products I design, build, ",["$","span",null,{"className":"text-brand-ink","children":"and ship"}],"."]}]}],["$","$L1d",null,{"direction":"up","distance":"nudge","delay":0.16,"children":["$","p",null,{"className":"t-body mt-2.5 max-w-lg text-ink/60","children":"Products I design, build, and ship — taken from product requirements to a deployed web application."}]}]]}],["$","$L7",null,{"step":0.14,"className":"grid grid-cols-1 gap-5 md:grid-cols-2","children":[["$","$L8","gitam-marketplace",{"variant":"scale","children":["$","$L1e",null,{"project":{"id":"gitam-marketplace","href":"/engineering/gitam-marketplace","name":"GITAM Marketplace","category":"Independent | Product Design & Web Development","url":"https://gitam-marketplace.in","urlDisplay":"gitam-marketplace.in","repo":"https://github.com/kasai22/gitamtrades","description":"Independently designed, built and deployed a university marketplace using React, Next.js, TypeScript and Tailwind CSS, integrating backend services for product workflows.","objective":"A student-only, peer-to-peer marketplace where verified GITAM students buy, sell and pass on items on campus. Listing is self-service and publishes immediately; safety is enforced by design rather than by an approval queue; payment always happens in person, never through the site.","stack":["Next.js 16 (App Router)","React 19","TypeScript (strict)","Tailwind CSS v4","shadcn/ui · Radix","Zod · React Hook Form","Supabase — Postgres, Auth, Storage, Realtime","Vitest · PGlite · Playwright"],"accent":"#0F6B5C","image":{"src":"/engineering/gitam-marketplace.png","alt":"GITAM Marketplace home page — join with a university email, list in under three minutes, chat then meet on campus","width":1440,"height":900},"ownership":{"designed":["Product requirements written up as a PRD, an implementation plan and a requirement-by-requirement traceability matrix.","The core journeys: university-email sign-up, a short publish-first listing form, search and filters, chat-then-meet exchange.","Safety UX — reports with case numbers, blocks, appeals, and safe-exchange guidance on the sell form, the listing and the chat.","Community threads with nested replies, voting, Hot/New/Top sorting and a moderation queue."],"implemented":["Feature-module architecture: auth, listings, search, messaging, moderation, admin, account and uploads, each owning its server actions, queries and components.","Shared UI primitives on shadcn/Radix, plus product components — cards, badges, empty, loading and error states.","A listing lifecycle state machine (draft, active, on hold, sold, expired, removed) that drives the seller's available actions.","A deterministic, versioned moderation rules engine in TypeScript.","Zod validation at every boundary."],"integrated":["Supabase Auth with the university email domain allowlist enforced in the database, and verification by link or 6-digit code.","Postgres with row-level security on every table and explicit grants; state changes go through database functions.","An image pipeline: upload route handler → file-type sniffing → re-encode to WebP (stripping EXIF/GPS) → thumbnail → QR-code detection; private storage served through short-lived signed URLs.","Realtime messaging, an admin console and audit trail."],"aiAssisted":["Implementation was accelerated with AI coding assistants, directed by the PRD, implementation plan and traceability matrix kept in the repository.","Generated code was reviewed, adapted and verified against the unit, database and end-to-end test suites and the production build."]},"challenges":[{"problem":"Listings must go live immediately — no human approval queue — without letting clearly prohibited items through.","approach":"Deterministic automated checks run on save: clear violations are blocked with a specific reason and a review path; ambiguous signals are hidden pending review."},{"problem":"The interface and the database could disagree about which status changes a seller is allowed to make.","approach":"The database function is the authority. The TypeScript mirror that drives the UI is checked against it in a parity test."},{"problem":"Event-ticket photos can carry barcodes, QR codes and booking codes.","approach":"Ticket listings with photos publish quarantined until a moderator checks them; text-only ticket listings publish immediately."}],"validation":["Unit tests for the moderation engine, schemas, state machine, search parameters and image pipeline (Vitest).","Database tests that apply the real migrations in PGlite and verify row-level security, triggers and RPCs — no Docker needed.","Playwright smoke tests and end-to-end MVP journeys."],"deployment":"Deployed on Vercel; Supabase for data, auth and storage.","excerpt":{"path":"src/features/listings/status.ts","caption":"The seller-side lifecycle. The database is the authority; this mirror drives the UI and is parity-tested against it.","code":"/**\n * Seller-initiated lifecycle transitions (PRD §8.3). The database function\n * public.listing_transition_allowed() is the authority; this mirror drives the UI and is checked\n * against the database in tests/db/status-parity.test.ts.\n */\nexport const SELLER_TRANSITIONS: Record<ListingStatus, readonly ListingStatus[]> = {\n  draft: [\"removed\"],\n  active: [\"on_hold\", \"sold\", \"removed\"],\n  on_hold: [\"active\", \"sold\", \"removed\"],\n  sold: [\"active\", \"removed\"],\n  expired: [\"active\", \"removed\"],\n  removed: [],\n};\n\nexport function canTransition(from: ListingStatus, to: ListingStatus): boolean {\n  return SELLER_TRANSITIONS[from].includes(to);\n}"}}}]}],"$L1f","$L20","$L21"]}]]}]]}]

2:T15b9,{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://chsaikomal.site/#person","name":"Sai Komal","alternateName":"Chunduri Sai Komal","url":"https://chsaikomal.site","email":"mailto:chundurisk1999@gmail.com","telephone":"+919505455999","jobTitle":"Product Designer & UX Engineer","description":"Product Designer and hands-on UX Engineer with 5 years across software, data work, and product design, including 4+ years in UX. Independently builds web applications using React, Next.js, TypeScript, and Tailwind CSS; integrates backend services and APIs; and brings strong Python and SQL capabilities. Combines enterprise UX, systems thinking, and AI-assisted development.","address":{"@type":"PostalAddress","addressLocality":"Visakhapatnam","addressCountry":"IN"},"worksFor":{"@type":"Organization","name":"Onliest"},"alumniOf":{"@type":"CollegeOrUniversity","name":"Vellore Institute of Technology"},"hasOccupation":[{"@type":"EmployeeRole","roleName":"UX Designer","startDate":"2026-05","worksFor":{"@type":"Organization","name":"Onliest"}},{"@type":"EmployeeRole","roleName":"Product Owner & UX Designer","startDate":"2024-11","endDate":"2026-05","worksFor":{"@type":"Organization","name":"ONDL"}},{"@type":"EmployeeRole","roleName":"UX Designer","startDate":"2022-10","endDate":"2024-11","worksFor":{"@type":"Organization","name":"Sweya Infotech"}},{"@type":"EmployeeRole","roleName":"SQL Developer","startDate":"2021-07","endDate":"2022-09","worksFor":{"@type":"Organization","name":"Oracle"}}],"knowsAbout":["Product Design","UX Engineering","Enterprise UX","AI Product Design","Human-AI Interaction","Design Systems","Information Architecture","Usability Testing","Data-Heavy Interfaces","React","Next.js","TypeScript","Tailwind CSS","Python","SQL","REST APIs","Figma"],"sameAs":["https://www.linkedin.com/in/chsk1999","https://github.com/kasai22","https://x.com/SaiKomal4"]},{"@type":"CreativeWork","name":"REX — AI Recommendation & Product Intelligence","url":"https://chsaikomal.site/case-study/rex","description":"AI product design case study: REX, a conversational recommendation engine — confidence signalling, ranking rationale, low-confidence, no-result and recovery states, and human-AI interaction patterns.","dateCreated":"2026","creator":{"@id":"https://chsaikomal.site/#person"}},{"@type":"CreativeWork","name":"Onliest HR Admin — Enterprise HRMS","url":"https://chsaikomal.site/case-study/onliest-hr-admin","description":"Enterprise UX project: Onliest HR Admin, an internal HRMS — role-based Admin, Manager and Employee workflows for attendance, leave, onboarding and approvals, with audit trails and accessible data entry.","dateCreated":"2026","creator":{"@id":"https://chsaikomal.site/#person"}},{"@type":"CreativeWork","name":"Kudra — Fleet & Trip Management","url":"https://chsaikomal.site/case-study/kudra","description":"Enterprise SaaS case study: Kudra, a fleet and trip management platform — field research, trip lifecycle, fleet dashboards and data-heavy interfaces. Trip-creation effort down 20%, manual operational effort down 30%.","dateCreated":"2025","creator":{"@id":"https://chsaikomal.site/#person"}},{"@type":"CreativeWork","name":"ClappIt — Cloud Infrastructure Platform","url":"https://chsaikomal.site/case-study/clappit","description":"Enterprise interaction design project: ClappIt, a cloud infrastructure platform — information architecture, navigation and reusable UI patterns that make infrastructure workflows usable for technical and non-technical users.","dateCreated":"2023","creator":{"@id":"https://chsaikomal.site/#person"}},{"@type":"CreativeWork","name":"Hindustan Shipyard Limited — Website Redesign","url":"https://chsaikomal.site/case-study","description":"Government and industrial UX case study: the Hindustan Shipyard Limited website redesign — stakeholder research, enterprise information architecture, navigation and responsive design across five modules.","dateCreated":"2024","creator":{"@id":"https://chsaikomal.site/#person"}},{"@type":"WebSite","name":"GITAM Marketplace","url":"https://gitam-marketplace.in","description":"Independently designed, built and deployed a university marketplace using React, Next.js, TypeScript and Tailwind CSS, integrating backend services for product workflows.","creator":{"@id":"https://chsaikomal.site/#person"},"subjectOf":{"@type":"SoftwareSourceCode","codeRepository":"https://github.com/kasai22/gitamtrades"}},{"@type":"WebSite","name":"Reality 3D","url":"https://reality3d.in","description":"Designed and developed a 3D-printing commerce experience with product discovery and customer-facing manufacturing workflows; implemented front-end features and backend/API integrations.","creator":{"@id":"https://chsaikomal.site/#person"},"subjectOf":{"@type":"SoftwareSourceCode","codeRepository":"https://github.com/kasai22/sada3d-world"}},{"@type":"WebSite","name":"HotelFirst","url":"https://hotelfirst.one","description":"Designed, developed and deployed a responsive business website, translating service needs into clear information architecture and customer-facing page journeys.","creator":{"@id":"https://chsaikomal.site/#person"}},{"@type":"WebSite","name":"Personal Portfolio","url":"https://chsaikomal.site","description":"Built and maintain a portfolio showcasing product case studies, design decisions and hands-on web development work.","creator":{"@id":"https://chsaikomal.site/#person"},"subjectOf":{"@type":"SoftwareSourceCode","codeRepository":"https://github.com/kasai22/saikomal_portfolio"}}]}0:{"P":null,"c":["","engineering","hotelfirst"],"q":"","i":false,"f":[[["",{"children":["engineering",{"children":[["slug","hotelfirst","d",null],{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",16],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/1yji210cj1zo0.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","script","script-0",{"src":"/_next/static/chunks/2xqb8
8:["$","section",null,{"children":[["$","$L4",null,{"label":"Stack","title":"Technology","accent":"stack"}],["$","ul",null,{"className":"flex flex-wrap gap-2","children":[["$","li","Next.js 16 (App Router)",{"className":"t-chip bg-paper-panel text-ink/80","children":"Next.js 16 (App Router)"}],["$","li","React 19",{"className":"t-chip bg-paper-panel text-ink/80","children":"React 19"}],["$","li","TypeScript (strict)",{"className":"t-chip bg-paper-panel text-ink/80","children":"TypeScript (strict)"}],["$","li","Tailwind CSS v4",{"className":"t-chip bg-paper-panel text-ink/80","children":"Tailwind CSS v4"}],["$","li","shadcn/ui · Radix",{"className":"t-chip bg-paper-panel text-ink/80","children":"shadcn/ui · Radix"}],["$","li","Zod · React Hook Form",{"className":"t-chip bg-paper-panel text-ink/80","children":"Zod · React Hook Form"}],["$","li","Supabase — Postgres, Auth, Storage, Realtime",{"className":"t-chip bg-paper-panel text-ink/80","children":"Supabase — Postgres, Auth, Storage, Realtime"}],["$","li","Vitest · PGlite · Playwright",{"className":"t-chip bg-paper-panel text-ink/80","children":"Vitest · PGlite · Playwright"}]]}]]}]
9:["$","section",null,{"children":[["$","$L4",null,{"label":"Ownership","title":"Designed, implemented,","accent":"integrated","sub":"What I did on each side of the project — kept separate, because they are different kinds of work. AI tools accelerated implementation; understanding the code, reviewing the output, integrating it and validating it stayed with me."}],["$","div",null,{"className":"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4","children":[["$","$L5","designed",{"className":"p-5 md:p-6","children":[["$","h3",null,{"className":"mb-4 text-[14px] font-semibold text-ink","children":"What I designed"}],["$","$L10",null,{"items":["Product requirements written up as a PRD, an implementation plan and a requirement-by-requirement traceability matrix.","The core journeys: university-email sign-up, a short publish-first listing form, search and filters, chat-then-meet exchange.","Safety UX — reports with case numbers, blocks, appeals, and safe-exchange guidance on the sell form, the listing and the chat.","Community threads with nested replies, voting, Hot/New/Top sorting and a moderation queue."]}]]}],["$","$L5","implemented",{"className":"p-5 md:p-6","children":[["$","h3",null,{"className":"mb-4 text-[14px] font-semibold text-ink","children":"What I implemented"}],["$","$L10",null,{"items":["Feature-module architecture: auth, listings, search, messaging, moderation, admin, account and uploads, each owning its server actions, queries and components.","Shared UI primitives on shadcn/Radix, plus product components — cards, badges, empty, loading and error states.","A listing lifecycle state machine (draft, active, on hold, sold, expired, removed) that drives the seller's available actions.","A deterministic, versioned moderation rules engine in TypeScript.","Zod validation at every boundary."]}]]}],["$","$L5","integrated",{"className":"p-5 md:p-6","children":[["$","h3",null,{"className":"mb-4 text-[14px] font-semibold text-ink","children":"What I integrated"}],["$","$L10",null,{"items":["Supabase Auth with the university email domain allowlist enforced in the database, and verification by link or 6-digit code.","Postgres with row-level security on every table and explicit grants; state changes go through database functions.","An image pipeline: upload route handler → file-type sniffing → re-encode to WebP (stripping EXIF/GPS) → thumbnail → QR-code detection; private storage served through short-lived signed URLs.","Realtime messaging, an admin console and audit trail."]}]]}],["$","$L5","aiAssisted",{"className":"p-5 md:p-6","children":[["$","h3",null,{"className":"mb-4 text-[14px] font-semibold text-ink","children":"Where AI assisted"}],["$","$L10",null,{"items":["Implementation was accelerated with AI coding assistants, directed by the PRD, implementation plan and traceability matrix kept in the repository.","Generated code was reviewed, adapted and verified against the unit, database and end-to-end test suites and the production build."]}]]}]]}]]}]

tracking-widest text-[color:var(--accent)]","children":"Approach"}],["$","p",null,{"className":"text-[14px] leading-relaxed text-ink/75","children":"The database function is the authority. The TypeScript mirror that drives the UI is checked against it in a parity test."}]]}]]}]}],["$","li","Event-ticket photos can carry barcodes, QR codes and booking codes.",{"children":["$","$L5",null,{"className":"grid grid-cols-1 gap-4 md:grid-cols-[48px_minmax(0,1fr)_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink/45","children":"03"}],["$","div",null,{"children":[["$","p",null,{"className":"mb-1 text-[11px] uppercase tracking-widest text-ink/55","children":"Challenge"}],["$","p",null,{"className":"text-[14px] leading-relaxed text-ink","children":"Event-ticket photos can carry barcodes, QR codes and booking codes."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"mb-1 text-[11px] uppercase tracking-widest text-[color:var(--accent)]","children":"Approach"}],["$","p",null,{"className":"text-[14px] leading-relaxed text-ink/75","children":"Ticket listings with photos publish quarantined until a moderator checks them; text-only ticket listings publish immediately."}]]}]]}]}]]}]]}]

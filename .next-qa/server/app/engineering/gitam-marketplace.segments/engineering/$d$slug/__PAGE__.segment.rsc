c:["$","section",null,{"children":[["$","$L4",null,{"label":"Code","title":"From the","accent":"repository","sub":"The seller-side lifecycle. The database is the authority; this mirror drives the UI and is parity-tested against it."}],["$","figure",null,{"className":"overflow-hidden rounded-sm border border-ink/12 bg-[#14140F]","children":[["$","figcaption",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-5 py-3 font-mono text-[12px] text-white/70","children":[["$","span",null,{"children":"src/features/listings/status.ts"}],["$","a",null,{"href":"https://github.com/kasai22/gitamtrades/blob/HEAD/src/features/listings/status.ts","target":"_blank","rel":"noopener noreferrer","className":"rounded-sm text-white/80 underline decoration-white/30 underline-offset-4 hover:text-white","children":["View on GitHub ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","pre",null,{"className":"overflow-x-auto p-5 text-[12.5px] leading-relaxed text-[#E8E6DD]","children":["$","code",null,{"children":"/**\n * Seller-initiated lifecycle transitions (PRD §8.3). The database function\n * public.listing_transition_allowed() is the authority; this mirror drives the UI and is checked\n * against the database in tests/db/status-parity.test.ts.\n */\nexport const SELLER_TRANSITIONS: Record<ListingStatus, readonly ListingStatus[]> = {\n  draft: [\"removed\"],\n  active: [\"on_hold\", \"sold\", \"removed\"],\n  on_hold: [\"active\", \"sold\", \"removed\"],\n  sold: [\"active\", \"removed\"],\n  expired: [\"active\", \"removed\"],\n  removed: [],\n};\n\nexport function canTransition(from: ListingStatus, to: ListingStatus): boolean {\n  return SELLER_TRANSITIONS[from].includes(to);\n}"}]}]]}]]}]

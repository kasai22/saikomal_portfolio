6:["$","$1","c",{"children":[["$","div",null,{"style":{"--accent":"#0C7E7E","--accent-subtle":"rgba(12,126,126,0.12)","--accent-border":"rgba(12,126,126,0.30)"},"className":"min-h-screen bg-paper text-ink","children":[["$","$L13",null,{}],["$","$L14",null,{}],["$","div",null,{"className":"mx-auto max-w-7xl space-y-16 px-6 pb-16","children":[["$","div",null,{"className":"border-ink/12 overflow-hidden rounded-sm border lg:hidden","children":["$","$L15",null,{"src":"/figmaAssets/image-16.png","alt":"Redesigned Hindustan Shipyard Limited homepage","width":1424,"height":711,"className":"block h-auto w-full"}]}],["$","section",null,{"children":[["$","$L16",null,{"label":"Case Study","title":"The","accent":"Overview"}],["$","$L17",null,{"children":["$","div",null,{"className":"space-y-4","children":[["$","p","0",{"className":"text-[13px] leading-relaxed text-ink/70","children":[["$","span","0",{"className":"$undefined","children":"Hindustan Shipyard Limited builds and repairs ships for the Indian Navy and commercial fleets. Its digital presence was "}],["$","span","1",{"className":"font-medium text-ink","children":"five disconnected systems wearing one logo"}],["$","span","2",{"className":"$undefined","children":" — recruitment, tenders, vendor management, vigilance and the public portfolio. Whichever one you landed in, it ended the same way: "}],["$","span","3",{"className":"font-medium text-ink","children":"send an email, then wait"}],["$","span","4",{"className":"$undefined","children":"."}]]}],["$","p","1",{"className":"text-[13px] leading-relaxed text-ink/70","children":[["$","span","0",{"className":"$undefined","children":"I worked on this at Sweya Infotech as "}],["$","span","1",{"className":"font-medium text-ink","children":"UX researcher, designer and stakeholder point of contact"}],["$","span","2",{"className":"$undefined","children":" — the person who sat with each module's owners, worked out what their branch needed, and carried it back into design. "}],["$","span","3",{"className":"font-medium text-ink","children":"It went live."}]]}]]}]}],["$","div",null,{"className":"mt-8","children":[["$","p",null,{"className":"mb-4 text-[11px] font-semibold uppercase tracking-widest text-ink/60","children":"What was in scope"}],["$","div",null,{"className":"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3","children":[["$","$L18","Recruitment / HRMS",{"icon":"◈","title":"Recruitment / HRMS","description":"Candidate applications, status visibility, payroll and attendance for internal staff."}],["$","$L18","Tenders",{"icon":"◎","title":"Tenders","description":"Live tender listings, requirements, and updates — moved out of email and onto the platform."}],["$","$L18","Vendor Management",{"icon":"⬡","title":"Vendor Management","description":"Procurement and partnership touchpoints for suppliers working with the shipyard."}],["$","$L18","Vigilance",{"icon":"✦","title":"Vigilance","description":"Case raising and follow-up, with compliance-mandated content kept intact."}],["$","$L18","Company Portfolio",{"icon":"◇","title":"Company Portfolio","description":"Capability, projects, and contact routes for clients, partners, and the public."}],["$","$L18","Accessibility",{"icon":"◐","title":"Accessibility","description":"Treated as a cross-cutting baseline across every module rather than a finishing pass."}]]}]]}]]}],["$","section",null,{"children":[["$","$L16",null,{"label":"Problem Statement","title":"The Operational","accent":"Reality"}],["$","$L17",null,{"className":"mb-6","children":["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/75","children":"The platform was outdated and non-responsive, but that was the symptom. The problem was that none of the five modules could answer a question on its own. A candidate had no way to know whether anyone had opened their application. A vendor waited on email rather than checking a status. Internally that turned HR and the tender cell into a human status API, answering by phone what a screen could have answered instantly. The objective: let each audience self-serve the answer they were chasing, on any device, to a standard accessible enough for a public-sector organisation serving the general public."}]}],"$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}],["$L2a","$L2b"],"$L2c"]}]

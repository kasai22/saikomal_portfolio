21:["$","section",null,{"children":[["$","$L16",null,{"label":"Define Phase","title":"Who I Designed","accent":"For","sub":"The three groups the stakeholder sessions kept pointing back to — described from what module owners reported, not from invented personas."}],["$","div",null,{"className":"grid grid-cols-1 gap-6 lg:grid-cols-3","children":[["$","$L33","applicants",{"className":"flex flex-col","children":[["$","span",null,{"className":"mb-4 w-fit rounded-full border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-[color:var(--accent)]","children":"Recruitment / HRMS"}],["$","h3",null,{"className":"mb-3 text-[15px] font-bold text-ink","children":"Job Applicants"}],["$","p",null,{"className":"mb-6 text-[13px] leading-relaxed text-ink/65","children":"Engineers and staff applying to HSL. They submit into a process with no visible stages, and cannot tell \"still under review\" from \"never opened\" from \"rejected\". Every follow-up means contacting HSL directly."}],["$","div",null,{"className":"mt-auto space-y-4","children":[["$","div","Frustrations",{"className":"rounded-sm border p-4 border-red-500/20 bg-red-500/5","children":[["$","p",null,{"className":"mb-3 text-[11px] font-semibold uppercase tracking-widest text-red-700","children":"Frustrations"}],["$","ul",null,{"className":"space-y-2","children":[["$","li","No acknowledgement or reference after submitting.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-red-700/80","aria-hidden":"true","children":"✗"}],"No acknowledgement or reference after submitting."]}],["$","li","No visibility into whether the application was reviewed.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-red-700/80","aria-hidden":"true","children":"✗"}],"No visibility into whether the application was reviewed."]}],["$","li","Outcomes by email only, with no fallback if it is missed.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-red-700/80","aria-hidden":"true","children":"✗"}],"Outcomes by email only, with no fallback if it is missed."]}]]}]]}],["$","div","Goals",{"className":"rounded-sm border p-4 border-ink/12 bg-ink/[0.035]","children":[["$","p",null,{"className":"mb-3 text-[11px] font-semibold uppercase tracking-widest text-ink/60","children":"Goals"}],["$","ul",null,{"className":"space-y-2","children":[["$","li","Apply without ambiguity about what was submitted.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-ink/60","aria-hidden":"true","children":"✦"}],"Apply without ambiguity about what was submitted."]}],["$","li","Know the current stage at any time.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-ink/60","aria-hidden":"true","children":"✦"}],"Know the current stage at any time."]}],["$","li","Understand what happens next.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-ink/60","aria-hidden":"true","children":"✦"}],"Understand what happens next."]}]]}]]}],["$","div","What I designed",{"className":"rounded-sm border p-4 border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)]","children":[["$","p",null,{"className":"mb-3 text-[11px] font-semibold uppercase tracking-widest text-[color:var(--accent)]","children":"What I designed"}],["$","ul",null,{"className":"space-y-2","children":[["$","li","A candidate login with the submitted resume on record.",{"className":"flex items-start gap-2 text-[13px] leading-relaxed text-ink/65","children":["$L44","A candidate login with the submitted resume on record."]}],"$L45","$L46"]}]]}]]}]]}],"$L47","$L48"]}]]}]
22:["$","section",null,{"children":[["$","$L16",null,{"label":"Process","title":"Design Thinking","accent":"Process","sub":"Five modules, five sets of stakeholders, and a brief that changed shape once research started — the process below is how that stayed manageable. The value wasn't the framework itself; it was that Empathize and Define ran long enough to reveal that this was a status-visibility problem rather than a visual one. Everything after that point was comparatively cheap, because the team was solving the right thing."}],["$","ol",null,{"className":"grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5","children":[["$","li","Empathize",{"children":["$","$L33",null,{"className":"h-full p-5 md:p-5","children":[["$","div",null,{"className":"mb-4 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] text-[11px] font-bold text-[color:var(--accent)]","children":1}],["$","h3",null,{"className":"text-[13px] font-bold text-ink","children":"Empathize"}]]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","Stakeholder Sessions",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"Stakeholder Sessions"]}],["$","li","Workflow Walkthroughs",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"Workflow Walkthroughs"]}],["$","li","Competitive Analysis",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"Competitive Analysis"]}]]}]]}]}],["$","li","Define",{"children":["$","$L33",null,{"className":"h-full p-5 md:p-5","children":[["$","div",null,{"className":"mb-4 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] text-[11px] font-bold text-[color:var(--accent)]","children":2}],["$","h3",null,{"className":"text-[13px] font-bold text-ink","children":"Define"}]]}],["$","ul",null,{"className":"space-y-2","children":[["$","li","User Groups",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"User Groups"]}],["$","li","Journey Mapping",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"Journey Mapping"]}],["$","li","Goal Statement",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"Goal Statement"]}],["$","li","Empathy Map",{"className":"flex items-start gap-2 text-[11px] leading-relaxed text-ink/62","children":[["$","span",null,{"className":"mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-[color:var(--accent)]"}],"Empathy Map"]}]]}]]}]}],["$","li","Ideate",{"children":["$","$L33",null,{"className":"h-full p-5 md:p-5","children":[["$","div",null,{"className":"mb-4 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] text-[11px] font-bold text-[color:var(--accent)]","children":3}],["$","h3",null,{"className":"text-[13px] font-bold text-ink","children":"Ideate"}]]}],"$L49"]}]}],"$L4a","$L4b"]}]]}]
23:["$","section",null,{"children":[["$","$L16",null,{"label":"Ideate Phase","title":"Information","accent":"Architecture","sub":"One structure spanning all five modules, so a user crossing from tenders into recruitment doesn't have to relearn the site."}],["$","div",null,{"className":"overflow-hidden rounded-sm border border-ink/12 bg-ink/[0.022]","children":["$","$L15",null,{"src":"/figmaAssets/image-15.png","alt":"Information architecture diagram showing the redesigned HSL site map","width":1972,"height":4096,"className":"block h-auto w-full"}]}]]}]
24:["$","section",null,{"children":[["$","$L16",null,{"label":"Design Phase","title":"Visual","accent":"Design","sub":"A current, credible look for a shipyard whose platform had stopped reflecting its actual capability — carried across desktop and mobile from the same component set."}],["$","div",null,{"className":"grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1fr)]","children":[["$","figure",null,{"className":"overflow-hidden rounded-sm border border-ink/12 bg-ink/[0.022] shadow-sm","children":[["$","$L15",null,{"src":"/figmaAssets/image-16.png","alt":"Visual design overview of the redesigned HSL homepage","width":1424,"height":711,"className":"block h-auto w-full"}],["$","figcaption",null,{"className":"px-5 py-4 text-[11px] text-ink/60","children":"Redesigned homepage — capability, tenders, and careers surfaced on the landing view instead of buried in navigation."}]]}],["$","figure",null,{"className":"overflow-hidden rounded-sm border border-ink/12 bg-ink/[0.022] shadow-sm","children":[["$","div",null,{"className":"max-h-[520px] overflow-hidden","children":["$","$L15",null,{"src":"/figmaAssets/image-17.png","alt":"Mobile-responsive preview of the redesigned HSL website","width":278,"height":4096,"className":"block h-auto w-full"}]}],["$","figcaption",null,{"className":"px-5 py-4 text-[11px] text-ink/60","children":"Mobile responsive — a baseline requirement, given how many applicants and vendors reach the site from a phone."}]]}]]}]]}]
25:["$","section",null,{"children":[["$","$L16",null,{"label":"Design System","title":"Typography &","accent":"Colour"}],["$","div",null,{"className":"grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]","children":[["$","$L33",null,{"children":[["$","p",null,{"className":"mb-4 text-[11px] font-semibold uppercase tracking-widest text-ink/60","children":"Typeface"}],["$","p",null,{"className":"mb-6 text-2xl font-semibold tracking-[-0.02em] text-[color:var(--accent)]","children":"Noto Sans"}],["$","div",null,{"className":"mb-6 space-y-1 text-[15px] text-ink/60","children":[["$","p",null,{"children":"ABCDEFGHIJKLMNOPQRSTUVWXYZ"}],["$","p",null,{"children":"abcdefghijklmnopqrstuvwxyz"}],["$","p",null,{"children":"1234567890"}]]}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/65","children":"A neutral, highly legible sans-serif chosen for reach rather than personality. HSL's platform has to work for applicants, vendors, and the general public across a wide range of devices and screen sizes, so the priority was clarity at small sizes and a full weight range to carry hierarchy through dense content like tender listings and HR records — without the typeface itself competing for attention."}]]}],["$","div",null,{"className":"space-y-6","children":[["$","$L33",null,{"children":[["$","p",null,{"className":"mb-5 text-[11px] font-semibold uppercase tracking-widest text-ink/60","children":"Weights in use"}],["$","div",null,{"className":"space-y-3","children":[["$","div","Bold",{"className":"flex items-baseline justify-between gap-4 border-b border-ink/[0.07] pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-lg text-ink font-bold","children":"Noto Sans"}],["$","span",null,{"className":"shrink-0 text-[11px] uppercase tracking-widest text-ink/60","children":"Bold"}]]}],["$","div","Regular",{"className":"flex items-baseline justify-between gap-4 border-b border-ink/[0.07] pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-lg text-ink font-normal","children":"Noto Sans"}],["$","span",null,{"className":"shrink-0 text-[11px] uppercase tracking-widest text-ink/60","children":"Regular"}]]}],["$","div","Medium",{"className":"flex items-baseline justify-between gap-4 border-b border-ink/[0.07] pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-lg text-ink font-medium","children":"Noto Sans"}],["$","span",null,{"className":"shrink-0 text-[11px] uppercase tracking-widest text-ink/60","children":"Medium"}]]}],["$","div","Light",{"className":"flex items-baseline justify-between gap-4 border-b border-ink/[0.07] pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-lg text-ink font-light","children":"Noto Sans"}],["$","span",null,{"className":"shrink-0 text-[11px] uppercase tracking-widest text-ink/60","children":"Light"}]]}]]}]]}],["$","$L33",null,{"children":[["$","p",null,{"className":"mb-5 text-[11px] font-semibold uppercase tracking-widest text-ink/60","children":"Colour"}],["$","div",null,{"className":"grid grid-cols-2 gap-3 sm:grid-cols-3","children":[["$","div","Primary Color-0",{"className":"overflow-hidden rounded-sm border border-ink/12","children":[["$","div",null,{"className":"h-16 w-full","style":{"backgroundColor":"#2947a3"},"aria-hidden":"true"}],["$","div",null,{"className":"bg-ink/[0.035] px-3 py-2","children":[["$","div",null,{"className":"text-[11px] font-semibold text-ink","children":"Primary Color"}],["$","div",null,{"className":"mt-0.5 font-mono text-[11px] text-ink/60","children":"#2947a3"}]]}]]}],["$","div","Secondary Color-1",{"className":"overflow-hidden rounded-sm border border-ink/12","children":[["$","div",null,{"className":"h-16 w-full","style":{"backgroundColor":"#fff3f4"},"aria-hidden":"true"}],["$","div",null,{"className":"bg-ink/[0.035] px-3 py-2","children":[["$","div",null,{"className":"text-[11px] font-semibold text-ink","children":"Secondary Color"}],["$","div",null,{"className":"mt
19:["$","div",null,{"className":"grid grid-cols-1 gap-6 lg:grid-cols-2","children":[["$","$L33",null,{"children":[["$","h3",null,{"className":"mb-5 font-semibold text-ink","children":"Where people got stuck"}],["$","$L34",null,{"items":["Candidates applied, then had no signal of any kind until an email arrived — if one arrived.","Vendors depended on email confirmations and updates to know where a tender stood.","Employees crossed between modules that each used different navigation and terminology."]}]]}],["$","$L33",null,{"children":[["$","div",null,{"className":"mb-5 h-1 w-8 rounded-full bg-red-500/50"}],["$","h3",null,{"className":"mb-5 font-semibold text-ink","children":"What it cost HSL"}],["$","ul",null,{"className":"space-y-2","children":[["$","li","HR and the tender cell became a human status API, answering the same question by phone all day.",{"className":"flex items-start gap-3 text-[13px] leading-relaxed text-ink/70","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-red-400/60","children":"✗"}]," ","HR and the tender cell became a human status API, answering the same question by phone all day."]}],["$","li","Information the platform already held was re-sent manually, one message at a time.",{"className":"flex items-start gap-3 text-[13px] leading-relaxed text-ink/70","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-red-400/60","children":"✗"}]," ","Information the platform already held was re-sent manually, one message at a time."]}],["$","li","A missed email was a dead end — there was no second place to check.",{"className":"flex items-start gap-3 text-[13px] leading-relaxed text-ink/70","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-red-400/60","children":"✗"}]," ","A missed email was a dead end — there was no second place to check."]}]]}]]}]]}]
1a:["$","section",null,{"children":[["$","$L16",null,{"label":"The Solution","title":"One Rule, Applied","accent":"Everywhere"}],["$","$L17",null,{"className":"mb-6","children":[["$","p",null,{"className":"mb-4 text-[15px] font-medium leading-relaxed text-ink","children":"Wherever someone was sending an email to find out where they stood, give them a screen that just tells them."}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/70","children":"The brief arrived as a website redesign. The stakeholder sessions turned it into an ecosystem problem, and the redesign was organised around one rule — wherever someone was emailing to find out where they stood, give them a screen that tells them. That meant a candidate login showing the submitted resume and whether the application is selected, rejected or in process; a tenders dashboard putting live tenders, requirements and updates on the site instead of in a mailbox; and one navigation model, component set and accessibility standard across all five modules, so HSL reads as one organisation."}]]}],["$","div",null,{"className":"grid grid-cols-1 gap-6 md:grid-cols-3","children":[["$","$L33","A candidate portal",{"children":[["$","div",null,{"className":"mb-4 text-[11px] font-bold tracking-widest text-[color:var(--accent)]","children":"01"}],["$","h3",null,{"className":"mb-3 text-[13px] font-bold text-ink","children":"A candidate portal"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/65","children":"Applicants log in to see their submitted resume on record and an explicit status — selected, rejected, or in process — instead of waiting on an email that may never arrive."}]]}],["$","$L33","A live tenders dashboard",{"children":[["$","div",null,{"className":"mb-4 text-[11px] font-bold tracking-widest text-[color:var(--accent)]","children":"02"}],["$","h3",null,{"className":"mb-3 text-[13px] font-bold text-ink","children":"A live tenders dashboard"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/65","children":"Live tenders, requirements, and updates published on the platform, making the site the authoritative source rather than a mail thread."}]]}],["$","$L33","One system, five modules",{"children":[["$","div",null,{"className":"mb-4 text-[11px] font-bold tracking-widest text-[color:var(--accent)]","children":"03"}],["$","h3",null,{"className":"mb-3 text-[13px] font-bold text-ink","children":"One system, five modules"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/65","children":"A shared navigation model, component set, and accessibility baseline across HRMS, tenders, vendor management, vigilance, and the public portfolio."}]]}]]}]]}]

7:["$","$1","c",{"children":[["$","div",null,{"style":{"--accent":"#8B6C32","--accent-subtle":"rgba(139,108,50,0.12)","--accent-border":"rgba(139,108,50,0.30)"},"className":"min-h-screen bg-paper text-ink","children":[["$","$L14",null,{}],["$","$L15",null,{}],["$","div",null,{"className":"mx-auto max-w-7xl space-y-6 px-6 pb-16","children":[["$","div",null,{"className":"border-ink/12 overflow-hidden rounded-sm border lg:hidden","children":["$","$L16",null,{"src":"/rex/rex-hero.svg","alt":"Onliest REX interface","width":1920,"height":1200,"className":"block h-auto w-full"}]}],["$","section",null,{"children":[["$","$L17",null,{"label":"Overview","title":"A Personal AI","accent":"Stylist, Not a Search Bar","sub":"REX was built to make discovering and designing the perfect saree feel effortless, personal, and inspiring — for a platform where trust and craftsmanship matter as much as technology."}],["$","$L18",null,{"className":"mb-8","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-ink/80","children":"Onliest REX is the AI recommendation, personalization, and product-design engine for Onliest.ai — a luxury fashion platform. Rather than behaving like a generic e-commerce recommender, REX is built to act as a personal AI stylist: understanding a customer's body, occasion, taste, and budget well enough to design a saree or blouse with them, not just for them."}]}],["$","div",null,{"className":"grid grid-cols-1 gap-5 md:grid-cols-3","children":[["$","div","My Role",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"My Role"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Owned the Business Requirements Document end to end and translated it into the conversational, wizard and try-on experiences shown here."}]]}],["$","div","The Challenge",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"The Challenge"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Turn a multi-agent AI system into something that feels like working with a stylist, not filling out a form."}]]}],["$","div","The Approach",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"The Approach"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"A low-friction conversation paired with a structured wizard, backed by a scored engine a customer can trust and an Admin team can control."}]]}]]}]]}],["$","section",null,{"children":[["$","$L17",null,{"label":"Problem Statement","title":"Fashion Discovery","accent":"Was Guesswork","sub":"Luxury customers deserve a stylist's judgment, not a filter panel — but building an AI stylist that's trustworthy, explainable, and commercially sustainable is a much harder problem."}],["$","$L18",null,{"className":"mb-8","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-ink/80","children":"Premium fashion customers often need guidance beyond simple filtering. They may not know what design suits their body, skin tone, occasion, or budget — and existing platforms respond with endless catalogs instead of understanding. Onliest needed an AI system that could ask the right questions, reason over trust-sensitive data, and still feel like luxury, not automation."}]}],"$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}],["$L24","$L25"],"$L26"]}]

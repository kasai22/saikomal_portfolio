20:["$","section",null,{"children":[["$","$L17",null,{"label":"Scope & Success Metrics","title":"Designed to Be","accent":"Governed, Not Guessed","sub":"As a BRD-driven, pre-launch product, success here is defined by the constraints and metrics built into the design — the guardrails that make the AI stylist trustworthy at scale."}],["$","div",null,{"className":"grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","div","Recommendation batch scaling",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L39",null,{"value":"5 → 25","delay":0}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Recommendation batch scaling"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Initial batch of 5 designs, 4 more per 'More' click, scaling up to an Admin-configurable maximum by loyalty tier."}]]}],["$","div","Scoring parameters per design",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L39",null,{"value":"8","delay":0.05}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Scoring parameters per design"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Overall Match, Confidence, Color Harmony, Occasion Match, and Preference Match are all surfaced individually, not collapsed into one opaque number."}]]}],["$","div","Tiered LLM routing paths",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L39",null,{"value":"2","delay":0.1}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Tiered LLM routing paths"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Llama for unpaid registered users, OpenAI for paid and Platinum members — with a future Onliest-owned domain-specific LLM planned for Phase 2."}]]}],["$","div","Languages in initial scope",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L39",null,{"value":"10","delay":0.15000000000000002}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Languages in initial scope"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"English, Hindi, Telugu, Tamil, Kannada, Malayalam, Marathi, Gujarati, Bengali, and Odiya — configurable through Admin as REX expands."}]]}],["$","div","Hardcoded recommendation rules",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L39",null,{"value":"0","delay":0.2}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Hardcoded recommendation rules"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Every weight, penalty, threshold, and prompt lives in the Admin configuration layer — not the codebase — to keep the business in control of its own AI."}]]}],["$","div","Algorithm access boundary",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L39",null,{"value":"CEO-only","delay":0.25}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Algorithm access boundary"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Proprietary scoring formulas and weights are visible only to the CEO or a CEO-delegated Product Controller, enforced through field-level encryption and RBAC."}]]}]]}]]}]
21:["$","$L3a",null,{"firstTake":"I designed the conversational flow first and treated the guided wizard as a fallback for people who did not get on with chat.","whatChangedIt":"Walking the flows with the fashion curator made it obvious that a blank conversation is its own blank page. For a high-value purchase, plenty of customers want to be led — the wizard was not a fallback, it was a first-class path.","whatIDid":"Gave both modes the same Match Score panel and the same underlying engine, so neither is the degraded option, and put four explicit entry paths on the landing instead of one prompt.","cost":"The scoring panel had to be redesigned to work in two very different layouts rather than one."}]
22:["$","section",null,{"children":[["$","$L17",null,{"label":"Reflection","title":"What This Project","accent":"Taught Me","sub":"Designing an AI stylist for a luxury brand meant every UX decision doubled as a trust decision."}],["$","$L18",null,{"children":["$","div",null,{"className":"space-y-5","children":[["$","div","Designing for trust mattered more than designing for cleverness — customers forgive a clarifying question far more readily than a confidently wrong recommendation.",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-[color:var(--accent)]","children":"✦"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/72","children":"Designing for trust mattered more than designing for cleverness — customers forgive a clarifying question far more readily than a confidently wrong recommendation."}]]}],["$","div","Giving every recommendation a visible, broken-down Match Score turned an opaque AI decision into something a customer (and the business) could actually reason about.",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-[color:var(--accent)]","children":"✦"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/72","children":"Giving every recommendation a visible, broken-down Match Score turned an opaque AI decision into something a customer (and the business) could actually reason about."}]]}],["$","div","Two entry points — free conversation and a structured Wizard — served very different customer mindsets without forking the underlying recommendation logic.",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-[color:var(--accent)]","children":"✦"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/72","children":"Two entry points — free conversation and a structured Wizard — served very different customer mindsets without forking the underlying recommendation logic."}]]}],["$","div","Writing the BRD alongside the UX meant every screen was traceable back to a business rule, which made trade-offs (like tiered LLM routing) a design decision, not just an engineering one.",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-0.5 shrink-0 text-[color:var(--accent)]","children":"✦"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/72","children":"Writing the BRD alongside the UX meant every screen was traceable back to a business rule, which made trade-offs (like tiered LLM routing) a design decision, not just an engineering one."}]]}]]}]}]]}]

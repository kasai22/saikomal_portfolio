19:["$","div",null,{"className":"grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","div","Decision Paralysis",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"Decision Paralysis"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Browsing thousands of sarees with no reliable way to know what suits your body, skin tone, occasion or cultural context. Customers default to endless scrolling."}]]}],["$","div","One-Size-Fits-All Recommenders",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"One-Size-Fits-All Recommenders"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Generic e-commerce logic treats a saree, a blouse and jewellery the same way, ignoring that fit, drape and occasion rules differ per product line."}]]}],["$","div","Inspiration Without Translation",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"Inspiration Without Translation"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Customers save Pinterest boards and wedding photos, but have no way to turn “I like this” into a manufacturable design without a human stylist."}]]}],["$","div","Trust & Hallucination Risk",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6 transition-colors duration-instant hover:border-ink/20","children":[["$","div",null,{"className":"mb-4 h-0.5 w-8 rounded-full bg-[color:var(--accent)]"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"Trust & Hallucination Risk"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"An AI stylist that invents availability, price or delivery destroys trust instantly — and bridal timing is non-negotiable."}]]}]]}]
1a:["$","section",null,{"children":[["$","$L17",null,{"label":"Solution","title":"An Agentic Engine","accent":"Behind a Human Experience","sub":"Every conversational or Wizard interaction is backed by a governed, multi-agent architecture — designed so customers feel a stylist's intuition while the business retains full control."}],["$","$L18",null,{"className":"mb-8","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-ink/80","children":"REX addresses this with a tiered, agentic architecture: a conversational and guided-wizard front end backed by independent per-product-line scoring, tiered LLM routing, and hallucination guardrails — all configurable from a single Admin layer instead of buried in code."}]}],["$","div",null,{"className":"grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","div","Conversational + Guided Wizard",{"className":"rounded-sm border border-ink/12 bg-ink/[0.033] p-6","children":[["$","div",null,{"className":"mb-4 flex h-11 w-11 items-center justify-center rounded-sm border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] text-base","children":"💬"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"Conversational + Guided Wizard"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Free chat, voice or an uploaded image, or a structured 14-step wizard — two entry points into the same engine."}]]}],["$","div","Product-Line Independent Scoring",{"className":"rounded-sm border border-ink/12 bg-ink/[0.033] p-6","children":[["$","div",null,{"className":"mb-4 flex h-11 w-11 items-center justify-center rounded-sm border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] text-base","children":"🧩"}],["$","h3",null,{"className":"t-h4 mb-2 text-ink","children":"Product-Line Independent Scoring"}],["$","p",null,{"className":"text-[13px] leading-relaxed text-ink/62","children":"Each category carries its own weights, fit rules and penalties, so
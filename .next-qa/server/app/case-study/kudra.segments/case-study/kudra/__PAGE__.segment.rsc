]}]]}]
17:["$","section",null,{"children":[["$","$L5",null,{"label":"Challenges","title":"What Made This","accent":"Hard"}],["$","div",null,{"className":"grid grid-cols-1 gap-6 md:grid-cols-3","children":[["$","$L7","Designing for Complex Logistics Workflows",{"children":[["$","div",null,{"className":"mb-4 h-1 w-8 rounded-full bg-red-500/50"}],["$","h3",null,{"className":"t-h4 mb-3 text-ink","children":"Designing for Complex Logistics Workflows"}],["$","p",null,{"className":"mb-4 text-[13px] leading-relaxed text-ink/65","children":"Fleet operations involved multiple stakeholders and edge-case scenarios — vehicles rerouted mid-trip, drivers swapping, branches changing plans. Balancing simplicity with operational depth became a central design challenge."}],["$","div",null,{"className":"rounded-sm border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] p-4 text-[13px]","children":[["$","span",null,{"className":"text-[11px] font-semibold uppercase tracking-widest text-[color:var(--accent)]","children":"Resolution"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-ink/70","children":"Built flexible trip states with override capabilities and designed exception handling directly into the workflow — not as an afterthought."}]]}]]}],["$","$L7","Managing Data-Heavy Interfaces",{"children":[["$","div",null,{"className":"mb-4 h-1 w-8 rounded-full bg-red-500/50"}],["$","h3",null,{"className":"t-h4 mb-3 text-ink","children":"Managing Data-Heavy Interfaces"}],["$","p",null,{"className":"mb-4 text-[13px] leading-relaxed text-ink/65","children":"The platform required displaying large amounts of operational information without overwhelming users. A single dashboard could surface hundreds of data points simultaneously."}],["$","div",null,{"className":"rounded-sm border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] p-4 text-[13px]","children":[["$","span",null,{"className":"text-[11px] font-semibold uppercase tracking-widest text-[color:var(--accent)]","children":"Resolution"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-ink/70","children":"Careful prioritization of visual hierarchy, information grouping, and dashboard readability — with progressive disclosure to keep the primary view clean."}]]}]]}],["$","$L7","Multiple Stakeholder Needs",{"children":[["$","div",null,{"className":"mb-4 h-1 w-8 rounded-full bg-red-500/50"}],["$","h3",null,{"className":"t-h4 mb-3 text-ink","children":"Multiple Stakeholder Needs"}],["$","p",null,{"className":"mb-4 text-[13px] leading-relaxed text-ink/65","children":"Fleet managers, branch managers, and accounts teams required different workflows and levels of visibility from the same underlying data. One screen could not serve all roles equally."}],["$","div",null,{"className":"rounded-sm border border-[color:var(--accent-border)] bg-[color:var(--accent-subtle)] p-4 text-[13px]","children":[["$","span",null,{"className":"text-[11px] font-semibold uppercase tracking-widest text-[color:var(--accent)]","children":"Resolution"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-ink/70","children":"Role-based views with shared data — same trip record, different UI surfaces depending on who's looking. The product supported fleet ops, branch coordination, financial reconciliation, and driver monitoring."}]]}]]}]]}]]}]
18:["$","section",null,{"children":[["$","$L5",null,{"label":"Outcomes & Impact","title":"Measurable","accent":"Results"}],["$","div",null,{"className":"mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2","children":[["$","div","20%Less trip-creation effort",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L43",null,{"value":"20%","delay":0}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Less trip-creation effort"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Consolidating trip creation, driver assignment and vehicle allocation into one structured workflow — with frequent-route suggestions — cut the effort of creating a trip."}]]}],["$","div","30%Less manual operational effort",{"className":"rounded-sm border border-ink/12 bg-ink/[0.035] p-6","children":[["$","div",null,{"className":"t-metric mb-2 text-[color:var(--accent)]","children":["$","$L43",null,{"value":"30%","delay":0.05}]}],["$","div",null,{"className":"mb-2 text-[13px] font-semibold text-ink","children":"Less manual operational effort"}],["$","div",null,{"className":"text-[11px] leading-relaxed text-ink/60","children":"Moving coordination out of calls, WhatsApp and spreadsheets and into trip states that everyone can see reduced the manual work of running the fleet day to day."}]]}]]}],["$","$L6",null,{"children":[["$","h3",null,{"className":"mb-4 font-bold text-ink","children":"Product Impact Summary"}],["$","div",null,{"className":"grid grid-cols-1 gap-3 sm:grid-cols-2","children":[["$","div","Every vehicle movement tied to a structured trip",{"className":"flex items-start gap-3 text-[13px] text-ink/70","children":[["$","span",null,{"className":"text-[color:var(--accent)]","children":"✦"}]," ","Every vehicle movement tied to a structured trip"]}],["$","div","Active trip visibility across branches",{"className":"flex it
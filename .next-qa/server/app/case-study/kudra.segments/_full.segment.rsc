1c:["$","section",null,{"children":[["$","$L17",null,{"label":"The Transformation","title":"From phone calls to a","accent":"measurable operation","sub":"The same fleet, at four points in its move from conversation-driven coordination to a structured, trip-centric system."}],["$","$L39",null,{"stages":[{"step":"01","title":"Manual, call-heavy operations","detail":"Fleet coordination ran on conversation. Status lived with whoever last picked up the phone.","items":"$7:props:children:0:props:children:2:props:children:2:props:children:1:props:children:0:props:children:1:props:items","image":{"src":"/kudra/add-device.png","alt":"Kudra — registering a vehicle and its GPS device","width":1918,"height":1026}},{"step":"02","title":"Structured workflows","detail":"Every operation became a defined step with a defined output, from trip creation through to reporting.","items":["Trip Creation","Trip Dispatch","Ongoing Monitoring","Fuel Tracking","Driver Halt Tracking","Trip Completion","Reports & Analytics"],"image":{"src":"/kudra/fleet-management.png","alt":"Kudra — structured vehicle registry with operational status","width":1918,"height":1026}},{"step":"03","title":"A trip-centric system","detail":"The trip replaced the vehicle as the unit of work, and carried its own state from creation to reconciliation.","items":["Created","Dispatched","Ongoing","Completed","Closed"],"image":{"src":"/kudra/live-tracking.png","alt":"Kudra — live trip tracking with halt-point timeline","width":1918,"height":1026}},{"step":"04","title":"Data-driven fleet operations","detail":"With every movement tied to a structured trip record, the operation could finally be measured.","items":["20% · Less trip-creation effort","30% · Less manual operational effort"],"image":{"src":"/kudra/vehicle-reports.png","alt":"Kudra — per-vehicle analytics and utilisation reporting","width":1918,"height":1026}}],"label":"How Kudra changed fleet operations"}]]}]
